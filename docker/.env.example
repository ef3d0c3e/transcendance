# Copy to .env and replace every value
MYSQL_ROOT_PASSWORD=
MYSQL_USER=transcendance
MYSQL_PASSWORD=
MYSQL_DATABASE=transcendance

# Gateway
DOMAIN=transcendance.pundalik.org
HTTP_PORT=8080
HTTPS_PORT=8443
# Extra certificate names, e.g. IP:192.168.1.10,DNS:transcendance.local
TLS_EXTRA_SANS=

# Admin sign-in: ssh -p AUTH_SSH_PORT <code>@<host>
AUTH_SSH_PORT=2233
AUTH_SESSION_TTL=12h

# Logs: secrets between services, init-env.sh generates the empty ones
ELASTIC_PASSWORD=
KIBANA_SYSTEM_PASSWORD=
KIBANA_GATEWAY_PASSWORD=
KIBANA_ENCRYPTION_KEY=
LOGSTASH_PASSWORD=
# Logs are kept 2 years at least by law, compressed after 2 weeks
LOG_RETENTION_DAYS=730
LOG_COMPRESS_AFTER_DAYS=14
