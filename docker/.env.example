# Copy to .env and replace every value, or run init-env.sh

# Database, logs, metrics and admin keys, e.g. a folder on a larger disk
DATA_DIR=./data
MYSQL_ROOT_PASSWORD=
MYSQL_USER=transcendance
MYSQL_PASSWORD=
MYSQL_DATABASE=transcendance

# Gateway
DOMAIN=transcendance.pundalik.org
HTTP_PORT=8080
HTTPS_PORT=8443
# Extra certificate names, e.g. IP:192.168.1.10,DNS:transcendance.local
TLS_EXTRA_SANS=
# Reverse proxies in front of the gateway, e.g. 172.19.0.1, see docs/DEPLOY.md
TRUSTED_PROXIES=

# Admin sign-in: ssh -p AUTH_SSH_PORT <code>@<host>
AUTH_SSH_PORT=2233
AUTH_SESSION_TTL=12h

# Logs: secrets between services, init-env.sh generates the empty ones
ELASTIC_PASSWORD=
KIBANA_SYSTEM_PASSWORD=
KIBANA_GATEWAY_PASSWORD=
KIBANA_ENCRYPTION_KEY=
LOGSTASH_PASSWORD=
# Logs are kept 2 years at least by law, compressed after 2 weeks
LOG_RETENTION_DAYS=730
LOG_COMPRESS_AFTER_DAYS=14
# Nightly snapshots of the logs, in DATA_DIR/log-archive, backups kept this long (see the privacy policy)
LOG_ARCHIVE_DAYS=30

# Monitoring
METRICS_RETENTION=30d
# Where alerts are sent besides Grafana, both optional: any webhook, a Discord channel's webhook
ALERT_WEBHOOK_URL=
ALERT_DISCORD_WEBHOOK_URL=
ES_EXPORTER_PASSWORD=
GRAFANA_ES_PASSWORD=
GRAFANA_ADMIN_PASSWORD=
MYSQLD_EXPORTER_PASSWORD=
# Docker's socket, init-env.sh asks Docker for it
DOCKER_SOCKET=/var/run/docker.sock
